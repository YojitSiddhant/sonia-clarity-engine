# Ask the Clarity Engine (server-side only — never prefix with NEXT_PUBLIC_).
# Without a key the Ask section shows a "not set up" message; the rest of the
# site works normally.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=

# Optional fallback, used only when Gemini fails (server-side only — never
# prefix with NEXT_PUBLIC_). Leave empty to use Gemini alone.
GROQ_API_KEY=
